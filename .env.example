# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server only. Same value as LAND_HANDOFF_SECRET on the hub. At least 32 characters.
# Verifies the 60-second handoff from www.db357.com. Never commit a real value.
LAND_HANDOFF_SECRET=

# Server only. Service role for https://fahkknzinragbeizymny.supabase.co.
# Finds an existing auth user and opens a session. It does not create a user or change a password.
# The handoff refuses any other Supabase host. Never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
